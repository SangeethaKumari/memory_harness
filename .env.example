#
# Since most our projects will need the configuration
# utility, this fixes the directory where to find them.
#
export BOOTCAMP_ROOT_DIR="/Users/chandarl/memory"

#
# Project's Python executable path
# Points to the virtual environment's Python interpreter
#
export PROJECT_PYTHON="/Users/chandarl/memory/.venv/bin/python"

#
# Precaution, needed for some IDEs
# to recognize that the main svlearn library code
# is in the src/ sub-directory
#
export PYTHONPATH="/Users/chandarl/memory/src"

# The OpenAI Key (Replace with your own key)
# For the lab cluster's OpenAI-compatible endpoint a dummy key is fine.
export OPENAI_API_KEY=not-needed

#
# Lab LLM endpoint (OpenAI-compatible / vLLM-style router)
# Router model id must match /v1/models exactly.
#
export LLM_API_BASE="http://10.0.10.51:8000/v1"
export LLM_MODEL_NAME="openai/gpt-oss-20b"

